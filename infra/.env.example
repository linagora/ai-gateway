# =============================================================================
# Passerelle IA Linagora — variables d'environnement (MODÈLE)
# Copier en /opt/linagora-ia/.env sur le serveur, chmod 600.
# Les valeurs "__GENERATE__" sont générées sur le serveur par scripts/gen-secrets.sh.
# Les valeurs "__ASK__" doivent être fournies par l'utilisateur.
# Ne JAMAIS versionner le fichier .env réel.
# Les URL composées (DATABASE_URL, PROXY_BASE_URL, AUTH_URL…) sont construites
# dans docker-compose.yml à partir de ces variables.
# =============================================================================

# --- Domaines -----------------------------------------------------------------
# Portail à la racine ; /admin (LiteLLM), /stats (Superset), /traces (Langfuse) sur le même domaine
DOMAIN_PORTAL=ai-gateway.linagora.com
# Endpoint OpenAI-compatible
DOMAIN_API=ai-api.linagora.com
ACME_EMAIL=__ASK__
# IP/CIDR autorisées sur /admin (UI LiteLLM), séparées par des espaces
ADMIN_ALLOWED_IPS=__ASK__

# --- Versions épinglées -------------------------------------------------------
# Versions validées le 2026-09-24 (tag + digest). Pour une mise à jour : runbook, phase 4.
# LiteLLM : release stable (sans suffixe -rc/-dev), signature cosign vérifiée
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.102.1@sha256:87f34979b9f8cb274fac90ca8a4fdda07d8480de22755562a26adeb95ce20d02
POSTGRES_IMAGE=postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
CADDY_IMAGE=caddy:2.11.4@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
# Valkey plutôt que Redis : Redis ≥ 7.4 n'est plus sous licence libre (décision du 2026-09-24)
REDIS_IMAGE=valkey/valkey:9.1.2-alpine@sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11
SUPERSET_BASE_IMAGE=apache/superset:6.1.0@sha256:16b50bbef6648912a79e3293d418fefa743ce555d36c5af6b85d859119ed7f88

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
LITELLM_DB_PASSWORD=__GENERATE__
PORTAL_DB_PASSWORD=__GENERATE__
SUPERSET_DB_PASSWORD=__GENERATE__
REPORTING_RO_PASSWORD=__GENERATE__
# Lecture seule du schéma reporting de la base portal, par le lien entre bases (scripts/installer-lien-portail.sh)
PORTAL_REPORTING_RO_PASSWORD=__GENERATE__

# --- LiteLLM ------------------------------------------------------------------
# doit commencer par sk-
LITELLM_MASTER_KEY=__GENERATE__
# chiffre les clés fournisseurs stockées en base — NE JAMAIS CHANGER après mise en service
LITELLM_SALT_KEY=__GENERATE__
# Compte admin local de la console LiteLLM, derrière le point de contrôle du portail (pas de SSO
# LiteLLM : sa limite gratuite de 5 utilisateurs compte tous les utilisateurs inscrits)
UI_USERNAME=admin
UI_PASSWORD=__GENERATE__

# Clés fournisseurs (peuvent aussi être saisies dans l'UI admin — stockées chiffrées)
OPENROUTER_API_KEY=__ASK__
# Endpoint OVHcloud Qwen3.8 (N3) — fourni par Linagora (OVH AI Endpoints, modèle Qwen3.8-27B)
OVH_QWEN_API_BASE=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_QWEN_API_KEY=__ASK__
# Nox-4B (N3) — LiteLLM de la carte GPU de LINAGORA (adresse en …/v1) et sa clé, limitée à ce modèle
NOX_API_BASE=__ASK__
NOX_API_KEY=__ASK__

# --- Portail Linagora ---------------------------------------------------------
AUTH_SECRET=__GENERATE__
OIDC_ISSUER=https://sso.linagora.com
OIDC_CLIENT_ID=portail-ia
OIDC_CLIENT_SECRET=__ASK__
# Listes d'uid gérées par Linagora (séparés par des virgules), appliquées par le point de contrôle
# du portail : admins (portail, console LiteLLM /admin, Superset) et lecteurs du reporting (/stats)
PORTAL_ADMIN_UIDS=__ASK__
PORTAL_REPORTING_UIDS=
# Courriels du portail (notifications bilingues, rappels) : sans hôte ou sans expéditeur, rien n'est envoyé.
# Port 465 : TLS implicite ; sinon STARTTLS si le serveur le propose. Utilisateur et mot de passe facultatifs.
SMTP_HOST=__ASK__
SMTP_PORT=587
SMTP_USER=__ASK__
SMTP_PASSWORD=__ASK__
SMTP_FROM=portail-ia@linagora.com
# Admins à notifier des nouvelles demandes, séparés par des virgules
ADMIN_NOTIFICATION_EMAILS=__ASK__
# Jeton des tâches du portail (tâche quotidienne appelée par le cron du serveur, passage manuel de la supervision)
PORTAL_TASK_TOKEN=__GENERATE__
# Supervision des modèles, planifiée dans le portail : intervalle entre deux sondes, en minutes (1 à 1440) ; 0 la désactive.
# Après un changement : docker compose --profile portal up -d portal
SUPERVISION_INTERVAL_MINUTES=5

# --- Superset -----------------------------------------------------------------
SUPERSET_SECRET_KEY=__GENERATE__
# uid LDAP du premier admin Superset (l'accès passe ensuite par le point de contrôle du portail)
SUPERSET_ADMIN_UID=__ASK__

# --- Langfuse (phase 2) ----------------------------------------------------------
# Adresse privée du service web Langfuse sur la seconde instance, ex. http://10.0.0.12:3000
LANGFUSE_UPSTREAM=
