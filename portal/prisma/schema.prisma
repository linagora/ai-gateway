// Base « portal » du Portail Linagora (brief §2). L'URL de connexion est dans prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// EXP : expérimental (modèles en bêta, données publiques uniquement, clés dédiées)
enum DataLevel {
  N1
  N2
  N3
  EXP
}

enum RequestStatus {
  SOUMISE
  A_COMPLETER
  /// Demande d'abonnement dont un responsable de l'équipe a donné son accord : elle attend l'approbation d'un admin
  /// (spécification #93).
  ACCORD_RESPONSABLE
  APPROUVEE
  REFUSEE
  ANNULEE
  CLE_EMISE
  EXPIREE
  REVOQUEE
  /// Demande d'abonnement dont l'abonnement est déclaré (spécification #51).
  DECLAREE
  /// Renouvellement d'abonnement approuvé : l'échéance de l'abonnement est reportée, sans nouvelle déclaration.
  RENOUVELEE
}

enum RequestKind {
  CLE
  ADHESION_EQUIPE
  ABONNEMENT
}

enum KeyType {
  PERSONNELLE
  SERVICE
}

/// Cas d'usage d'un modèle : liste fermée commune à tous les modèles, libellés dans les dictionnaires.
/// Quatre cas depuis le 2026-09-25 : rédaction et analyse (dont traduction, documents longs, raisonnement et
/// transcription), code, extraction et automatisation (dont décision structurée), création d'images.
enum UseCase {
  WRITING_ANALYSIS
  CODING
  EXTRACTION_AUTOMATION
  IMAGE_CREATION
}

/// Fiche d'un modèle LiteLLM (model_name), saisie par l'admin : textes en français (obligatoires,
/// sauf les limites) et en anglais (facultatifs, repli sur le français), cas d'usage et recommandations.
/// Les faits techniques (éditeur, zone, capacités, prix…) viennent de la passerelle.
model CatalogEntry {
  modelName          String    @id
  displayNameFr      String
  displayNameEn      String?
  shortDescriptionFr String
  shortDescriptionEn String?
  longDescriptionFr  String
  longDescriptionEn  String?
  limitationsFr      String?
  limitationsEn      String?
  useCases           UseCase[] @default([])
  /// sous-ensemble de useCases
  recommendedFor     UseCase[] @default([])
  dataLevel          DataLevel
  visible            Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
  updatedBy          String
}

model AccessRequest {
  id              String        @id @default(cuid())
  kind            RequestKind
  requesterUid    String
  requesterEmail  String
  /// nom du demandeur au dépôt de la demande (SSO) ; absent des demandes plus anciennes
  requesterName   String?
  /// team_id LiteLLM
  teamId          String
  teamAlias       String
  /// obligatoire si kind = CLE
  dataLevel       DataLevel?
  models          String[]
  justification   String
  project         String?
  keyType         KeyType?
  requestedBudget Decimal?
  requestedDays   Int?
  // paramètres figés par l'admin à l'approbation
  approvedModels  String[]
  approvedBudget  Decimal?
  /// ex. "30d"
  budgetDuration  String?
  approvedDays    Int?
  rpmLimit        Int?
  tpmLimit        Int?
  status          RequestStatus @default(SOUMISE)
  decidedBy       String?
  decisionComment String?
  decidedAt       DateTime?
  /// Accord du responsable (spécification #93) : son auteur, sa date et son commentaire facultatif pour l'admin.
  agreedBy        String?
  agreedAt        DateTime?
  agreementComment String?
  /// renseigné à la génération
  keyAlias        String?
  /// empreinte (token_id) — JAMAIS la clé
  keyTokenId      String?
  keyIssuedAt     DateTime?
  /// date d'expiration de la clé émise (le remplacement la conserve)
  keyExpiresAt    DateTime?
  /// nombre de remplacements de la clé (suffixe -2, -3… de l'alias)
  keyReplacements Int           @default(0)
  /// demande dont cette demande renouvelle la clé
  renewsRequestId String?
  /// rappel de retrait envoyé par la tâche quotidienne (une seule fois)
  pickupReminderSentAt DateTime?
  /// dernier rappel d'expiration envoyé : date d'envoi et délai annoncé, en jours (30, 7 ou 1)
  expiryReminderSentAt DateTime?
  expiryReminderLead   Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([requesterUid])
  @@index([status])
  /// Demande d'abonnement (spécification #51) : l'offre demandée, puis l'abonnement déclaré.
  offerId         String?
  offer           SubscriptionOffer? @relation(fields: [offerId], references: [id])
  subscription    Subscription?
  /// abonnement dont cette demande renouvelle l'échéance (ticket #59)
  renewsSubscriptionId   String?
  /// abonnement que cette demande remplace par une autre offre du même fournisseur (changement d'offre, ticket #59)
  replacesSubscriptionId String?
}

/// Valeurs par défaut configurables (F-51) : default_budget, default_budget_duration, default_days,
/// default_rpm, default_tpm, pickup_days.
model Setting {
  key       String   @id
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  actorUid String
  /// REQUEST_CREATED, REQUEST_APPROVED, KEY_GENERATED, KEY_REVOKED, CATALOG_UPDATED…
  action   String
  targetId String?
  /// jamais de secret
  details  Json
}

/// Responsable d'équipe (F-54) : tenu par le portail, les « admins d'équipe » de LiteLLM étant une fonction
/// Enterprise (ADR 0001). L'adresse, lue dans LiteLLM à la désignation, sert aux courriels.
model TeamManager {
  teamId       String
  uid          String
  email        String
  designatedBy String
  designatedAt DateTime @default(now())

  @@id([teamId, uid])
  @@index([uid])
}

/// Alerte de budget d'équipe (F-54) : seuil déjà annoncé (80 ou 100 %) pour la période en cours, repérée par la date
/// de remise à zéro du budget dans LiteLLM et par le budget lui-même ; une nouvelle période, ou un nouveau budget,
/// fait repartir les alertes.
model TeamBudgetAlert {
  teamId  String    @id
  resetAt DateTime?
  budget  Decimal
  level   Int
  sentAt  DateTime
}

/// Offre d'abonnement (spécification #51) : produit payant d'un fournisseur, à souscrire individuellement, présenté au
/// catalogue avec son prix mensuel TTC et son niveau maximal. Tenue par le portail : LiteLLM n'en sait rien.
model SubscriptionOffer {
  id              String    @id @default(cuid())
  supplier        String
  name            String
  monthlyPriceEur Decimal
  dataLevel       DataLevel
  rulesFr         String
  rulesEn         String?
  url             String?
  visible         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  updatedBy       String
  requests        AccessRequest[]
  subscriptions   Subscription[]
}

/// Statut d'un abonnement : actif, à résilier (demande de résiliation en cours) ou résilié.
enum SubscriptionStatus {
  ACTIF
  A_RESILIER
  RESILIE
}

/// Origine d'une demande de résiliation : un responsable de l'équipe, un admin, la sortie de l'équipe, l'échéance d'un
/// abonnement non renouvelé, ou le refus de son renouvellement.
enum TerminationOrigin {
  RESPONSABLE
  ADMIN
  SORTIE
  ECHEANCE
  RENOUVELLEMENT_REFUSE
}

/// Abonnement (spécification #51) : offre souscrite par un salarié lui-même, après la validation de sa demande, puis
/// déclarée dans le portail ; il est rattaché à l'une de ses équipes. L'échéance est celle de son autorisation.
model Subscription {
  id               String             @id @default(cuid())
  requestId        String             @unique
  request          AccessRequest      @relation(fields: [requestId], references: [id])
  offerId          String
  offer            SubscriptionOffer  @relation(fields: [offerId], references: [id])
  holderUid        String
  holderEmail      String
  holderName       String?
  teamId           String
  teamAlias        String
  /// Adresse du compte chez le fournisseur, éventuellement hors de LINAGORA.
  accountEmail     String
  subscribedAt     DateTime
  monthlyAmountEur Decimal
  expiresAt        DateTime
  status           SubscriptionStatus @default(ACTIF)
  /// Demande de résiliation (statut « à résilier ») : origine, auteur (uid), date et motif ; gardée après la résiliation.
  /// « termination » nomme la résiliation dans le code : « cancel » y désigne déjà l'annulation d'une demande.
  terminationOrigin      TerminationOrigin?
  terminationRequestedBy String?
  terminationRequestedAt DateTime?
  terminationReason      String?
  /// Alerte unique aux responsables et aux admins : résiliation demandée, non déclarée dans le délai de retrait.
  terminationAlertSentAt DateTime?
  /// Date de résiliation (statut « résilié ») : aucun prélèvement à partir de ce jour.
  terminatedOn     DateTime?
  /// dernier rappel d'échéance envoyé (ticket #59) : date d'envoi et délai annoncé, en jours (30, 7 ou 1)
  expiryReminderSentAt DateTime?
  expiryReminderLead   Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  charges          SubscriptionCharge[]

  @@index([holderUid])
  @@index([teamId])
}

/// Prélèvement (spécification #51) : montant mensuel d'un abonnement compté à une date anniversaire de sa souscription,
/// avec le montant alors en vigueur, imputé à l'équipe de l'abonnement à cette date. Un seul par abonnement et par date.
model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  chargedOn      DateTime
  amountEur      Decimal
  teamId         String
  teamAlias      String
  createdAt      DateTime     @default(now())
  /// Transmission à la comptabilité qui l'a emporté, pour le remboursement du titulaire ; nulle tant qu'il reste à transmettre.
  transmissionId String?
  transmission   ChargeTransmission? @relation(fields: [transmissionId], references: [id])

  @@unique([subscriptionId, chargedOn])
  @@index([teamId])
  @@index([transmissionId])
}

/// Transmission à la comptabilité (retours de l'utilisateur du 2026-09-26) : liste datée des prélèvements à rembourser
/// aux collaborateurs, jusqu'à la fin d'un mois, sur la base de leurs déclarations ; un prélèvement n'est transmis qu'une fois.
model ChargeTransmission {
  id            String               @id @default(cuid())
  /// Mois choisi (AAAA-MM) : la transmission emporte les prélèvements restants jusqu'à sa fin.
  month         String
  transmittedAt DateTime             @default(now())
  transmittedBy String
  chargeCount   Int
  totalEur      Decimal
  charges       SubscriptionCharge[]
}

/// Périmètre d'une intégration (spécification #71) : ce qu'un admin l'autorise à faire pour un collaborateur.
enum IntegrationScope {
  LECTURE
  DEMANDES
  CLES
}

/// Intégration (spécification #71, ADR 0003) : application tierce, déclarée par un admin, qui agit pour un
/// collaborateur par l'API du portail, dans la limite de ses périmètres. Son identifiant sert d'`iss` à ses jetons et
/// de canal au journal d'audit ; elle se crée désactivée et ne se supprime jamais.
model Integration {
  id                 String             @id
  name               String
  scopes             IntegrationScope[]
  /// Adresses IP et plages CIDR d'où elle appelle l'API.
  ipRanges           String[]
  /// Plafond de requêtes par minute, tous collaborateurs confondus.
  rateLimitPerMinute Int                @default(120)
  active             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  createdBy          String
  updatedAt          DateTime           @updatedAt
  keys               IntegrationKey[]
}

/// Clé publique d'une intégration : elle vérifie la signature de ses jetons ; le `kid` de leur en-tête la désigne.
/// Une clé mise hors service ne vérifie plus rien, mais reste inscrite : son `kid` ne resservira pas.
model IntegrationKey {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  kid           String
  /// Algorithme imposé aux jetons signés par cette clé : EdDSA (Ed25519) ou RS256.
  algorithm     String
  /// Clé publique au format PEM (SPKI).
  publicKeyPem  String
  createdAt     DateTime    @default(now())
  createdBy     String
  removedAt     DateTime?
  removedBy     String?

  @@unique([integrationId, kid])
}

/// Catégorie d'une nouveauté (spécification #124), montrée par son libellé et son pictogramme.
enum NewsCategory {
  MODELES
  PRIX
  FONCTIONNALITES
  SERVICE
}

/// Nouveauté (spécification #124) : annonce rédigée par un admin pour tous les collaborateurs. Brouillon tant qu'elle
/// n'a pas de date de publication ; la publier la signale par la cloche de l'en-tête.
model NewsItem {
  id          String        @id @default(cuid())
  category    NewsCategory
  titleFr     String
  /// Résumé court, sans mise en forme, affiché dans le panneau de la cloche.
  summaryFr   String
  bodyFr      String
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  /// uid du dernier admin qui l'a modifiée.
  updatedBy   String
  receipts    NewsReceipt[]
}

/// Accusé de lecture : un collaborateur a confirmé, par « J'ai lu », avoir pris connaissance d'une nouveauté.
model NewsReceipt {
  newsItemId String
  newsItem   NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  uid        String
  readAt     DateTime @default(now())

  @@id([newsItemId, uid])
}
