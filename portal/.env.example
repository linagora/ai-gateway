# Variables du Portail Linagora. En production, elles sont fournies par infra/docker-compose.yml
# (service portal) depuis /opt/linagora-ia/.env. En développement : copier en .env (ignoré par git).

# Base « portal »
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/portal

# API d'administration LiteLLM (préfixe /admin) — clé maître : serveur uniquement
LITELLM_BASE_URL=http://127.0.0.1:54400/admin
LITELLM_MASTER_KEY=sk-dev-master-key
# URL publique de l'API, affichée dans les exemples d'usage
PUBLIC_API_BASE_URL=http://127.0.0.1:54400/admin/v1

# Auth.js (next-auth v5) — AUTH_SECRET : `openssl rand -hex 32` en production
AUTH_URL=http://localhost:3100
AUTH_SECRET=dev-only-auth-secret-not-for-production-0123456789

# OIDC : LemonLDAP::NG en production (client « portail-ia », redirect URI {AUTH_URL}/api/auth/callback/lemonldap),
# fournisseur simulé en développement (dev/docker-compose.yml, service oidc)
OIDC_ISSUER=http://127.0.0.1:54500/default
OIDC_CLIENT_ID=portail-ia
OIDC_CLIENT_SECRET=dev-only-client-secret

# uid des administrateurs, séparés par des virgules (F-03)
PORTAL_ADMIN_UIDS=mmaudet
